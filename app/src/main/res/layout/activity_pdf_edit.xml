<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btnInfo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/how_to_edit"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_info"
            app:tint="@color/text_primary" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/editActions"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnUndo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/undo"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_undo"
                app:tint="@color/tool_tint" />

            <ImageButton
                android:id="@+id/btnRedo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/redo"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_redo"
                app:tint="@color/tool_tint" />

            <FrameLayout
                android:id="@+id/btnDone"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_done_btn"
                android:minWidth="64dp">

                <TextView
                    android:id="@+id/tvDone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/done"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/pbDone"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/white"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FF000000">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />

        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary" />
    </FrameLayout>

    <!-- Edit text · Add text · Add image · Annotate · Sign -->
    <LinearLayout
        android:id="@+id/mainTools"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="@color/surface"
        android:orientation="horizontal">

        <include android:id="@+id/toolEditText" layout="@layout/item_bottom_tool" />
        <include android:id="@+id/toolAddText" layout="@layout/item_bottom_tool" />
        <include android:id="@+id/toolAddImage" layout="@layout/item_bottom_tool" />
        <include android:id="@+id/toolAnnotate" layout="@layout/item_bottom_tool" />
        <include android:id="@+id/toolSign" layout="@layout/item_bottom_tool" />
    </LinearLayout>

    <!-- Add text / Edit text -->
    <LinearLayout
        android:id="@+id/textPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/btnTextBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="11dp"
                android:rotation="180"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvTextHint"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_field"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:text="@string/tap_anywhere_add_text"
                android:textColor="@color/text_hint"
                android:textSize="13sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/textColors"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="16dp">

            <SeekBar
                android:id="@+id/sbTextSize"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="66"
                android:progress="66"
                android:progressTint="@color/primary"
                android:thumbTint="@color/primary" />

            <TextView
                android:id="@+id/tvTextSize"
                android:layout_width="52dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_search_field"
                android:drawablePadding="2dp"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="6dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                app:drawableEndCompat="@drawable/ic_caret_down"
                app:drawableTint="@color/text_primary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Annotate: Color / Size + eraser, highlight, underline, strikethrough, pen -->
    <LinearLayout
        android:id="@+id/annotatePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp">

            <LinearLayout
                android:id="@+id/tabColor"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:id="@+id/tabColorDot"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/bg_badge_red" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/color"
                    android:textColor="@color/tool_tint"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabSize"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_pen"
                    app:tint="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/size"
                    android:textColor="@color/tool_tint"
                    android:textSize="10sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/annColorsScroll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/annColors"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="12dp" />
            </HorizontalScrollView>

            <SeekBar
                android:id="@+id/sbAnnSize"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="30"
                android:progressTint="@color/primary"
                android:thumbTint="@color/primary"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnAnnBack"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="12dp"
                android:rotation="180"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/annEraser"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/eraser"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_eraser"
                app:tint="@color/tool_tint" />

            <ImageButton
                android:id="@+id/annHighlight"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/highlight"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_text_highlight"
                app:tint="@color/tool_tint" />

            <ImageButton
                android:id="@+id/annUnderline"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/underline"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_underline"
                app:tint="@color/tool_tint" />

            <ImageButton
                android:id="@+id/annStrike"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/strikethrough"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_strike"
                app:tint="@color/tool_tint" />

            <ImageButton
                android:id="@+id/annPen"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/pen"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pen"
                app:tint="@color/tool_tint" />
        </LinearLayout>
    </LinearLayout>

    <!-- Sign: + Add signature / saved signatures -->
    <LinearLayout
        android:id="@+id/signPanel"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnSignBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="11dp"
            android:rotation="180"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/btnAddSignatureWide"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_add_signature"
            android:gravity="center"
            android:text="@string/add_signature"
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:id="@+id/signListScroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/signList"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnAddSignature"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_add_signature"
                    android:gravity="center"
                    android:text="@string/add_short"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>
