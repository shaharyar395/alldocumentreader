<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <FrameLayout
        android:id="@+id/phone"
        android:layout_width="236dp"
        android:layout_height="460dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="80dp"
        android:background="@drawable/bg_phone_frame"
        android:padding="7dp"
        android:rotation="-7">

        <LinearLayout
            android:id="@+id/screen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_phone_screen"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_back"
                app:tint="@color/paper_text" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@color/white"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="6dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Market "
                        android:textColor="@color/paper_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_highlight_word"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:text="Outlook"
                        android:textColor="@color/paper_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Q2-Q3 2024"
                    android:textColor="@color/primary"
                    android:textSize="8sp" />

                <View
                    android:layout_width="44dp"
                    android:layout_height="1.5dp"
                    android:background="#E53935" />
            </LinearLayout>

            <TextView
                style="@style/MockHeading"
                android:text="Current Economic Landscape" />

            <View style="@style/MockBarDark" android:layout_width="match_parent" />
            <View style="@style/MockBarDark" android:layout_width="match_parent" />
            <View style="@style/MockBarDark" android:layout_width="170dp" />
            <View style="@style/MockBarDark" android:layout_width="match_parent" />
            <View style="@style/MockBarDark" android:layout_width="120dp" />

            <TextView
                style="@style/MockHeading"
                android:text="Technology" />

            <View style="@style/MockBarDark" android:layout_width="match_parent" />
            <View style="@style/MockBarDark" android:layout_width="match_parent" />
            <View style="@style/MockBarDark" android:layout_width="150dp" />
            <View style="@style/MockBarDark" android:layout_width="match_parent" />

            <TextView
                style="@style/MockHeading"
                android:text="Healthcare" />

            <View style="@style/MockBarDark" android:layout_width="match_parent" />
            <View style="@style/MockBarDark" android:layout_width="160dp" />
            <View style="@style/MockBarDark" android:layout_width="match_parent" />
            <View style="@style/MockBarDark" android:layout_width="100dp" />
        </LinearLayout>
    </FrameLayout>

    <ImageView
        android:id="@+id/tileText"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="end"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="60dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_tile_text" />

    <ImageView
        android:id="@+id/penButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="56dp"
        android:layout_marginTop="380dp"
        android:elevation="6dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_pen_circle" />

    <LinearLayout
        android:id="@+id/formatBar"
        android:layout_width="170dp"
        android:layout_height="46dp"
        android:layout_gravity="end"
        android:layout_marginTop="330dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_white_round"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <TextView
            style="@style/ToolbarGlyph"
            android:text="A" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_underline"
            app:tint="@color/primary" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_strike"
            app:tint="@color/primary" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_pen"
            app:tint="@color/primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_onboarding_fade" />

    <TextView
        android:id="@+id/tvTitle"
        style="@style/OnboardTitle"
        android:text="@string/onb_title_2" />
</FrameLayout>
