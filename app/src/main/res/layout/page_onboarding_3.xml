<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <FrameLayout
        android:id="@+id/phone"
        android:layout_width="252dp"
        android:layout_height="470dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="80dp"
        android:background="@drawable/bg_phone_frame"
        android:padding="7dp">

        <LinearLayout
            android:id="@+id/screen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_phone_screen"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="14dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_back"
                    app:tint="@color/text_primary" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView style="@style/MockIcon" android:importantForAccessibility="no" android:src="@drawable/ic_undo" />
                <ImageView style="@style/MockIcon" android:importantForAccessibility="no" android:src="@drawable/ic_redo" />
                <ImageView style="@style/MockIcon" android:importantForAccessibility="no" android:src="@drawable/ic_download" />
                <ImageView style="@style/MockIcon" android:importantForAccessibility="no" android:src="@drawable/ic_share" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:background="@drawable/bg_selection_box"
                    android:padding="3dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_avatar" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Riley K. Morgan"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Product Manager"
                        android:textColor="@color/text_secondary"
                        android:textSize="7.5sp" />

                    <View style="@style/MockBar" android:layout_width="90dp" />
                    <View style="@style/MockBar" android:layout_width="100dp" />
                    <View style="@style/MockBar" android:layout_width="70dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/MockHeading" android:text="Contact" />
                    <View style="@style/MockBar" android:layout_width="60dp" />
                    <View style="@style/MockBar" android:layout_width="50dp" />
                    <View style="@style/MockBar" android:layout_width="64dp" />
                    <View style="@style/MockBar" android:layout_width="56dp" />
                    <TextView style="@style/MockHeading" android:text="Education" />
                    <View style="@style/MockBar" android:layout_width="50dp" />
                    <View style="@style/MockBar" android:layout_width="64dp" />
                    <View style="@style/MockBar" android:layout_width="44dp" />
                    <TextView style="@style/MockHeading" android:text="Skills" />
                    <View style="@style/MockBar" android:layout_width="58dp" />
                    <View style="@style/MockBar" android:layout_width="48dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.6"
                    android:orientation="vertical">

                    <TextView style="@style/MockHeading" android:text="Experience" />
                    <View style="@style/MockBar" android:layout_width="match_parent" />
                    <View style="@style/MockBar" android:layout_width="match_parent" />
                    <View style="@style/MockBar" android:layout_width="90dp" />
                    <View style="@style/MockBar" android:layout_width="match_parent" />
                    <View style="@style/MockBar" android:layout_width="110dp" />
                    <View style="@style/MockBar" android:layout_width="match_parent" />
                    <View style="@style/MockBar" android:layout_width="match_parent" />
                    <View style="@style/MockBar" android:layout_width="80dp" />
                    <View style="@style/MockBar" android:layout_width="match_parent" />
                    <View style="@style/MockBar" android:layout_width="100dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/chipResume"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="270dp"
        android:layout_marginEnd="34dp"
        android:background="@drawable/bg_selection_box"
        android:elevation="6dp"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:text="Resume|"
        android:textColor="@color/primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/formatBar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="350dp"
        android:layout_marginEnd="30dp"
        android:background="@drawable/bg_white_round"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_image_line"
            app:tint="@color/text_primary" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_crop"
            app:tint="@color/text_primary" />

        <TextView
            style="@style/ToolbarGlyph"
            android:fontFamily="serif"
            android:text="Aa"
            android:textStyle="italic" />

        <TextView
            style="@style/ToolbarGlyph"
            android:text="AA" />

        <TextView
            android:id="@+id/glyphColor"
            style="@style/ToolbarGlyph"
            android:text="A" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_onboarding_fade" />

    <TextView
        android:id="@+id/tvTitle"
        style="@style/OnboardTitle"
        android:text="@string/onb_title_3" />
</FrameLayout>
