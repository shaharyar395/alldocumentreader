<?xml version="1.0" encoding="utf-8"?>
<!-- First switch to Horizontal: "Swipe left/right to turn pages" over the dimmed reader -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:clickable="true"
    android:elevation="20dp"
    android:focusable="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="80dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="152dp">

            <ImageView
                android:layout_width="220dp"
                android:layout_height="80dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_swipe_arrows" />

            <!-- the original's hand (index finger up), same size as there -->
            <ImageView
                android:id="@+id/ivHand"
                android:layout_width="58dp"
                android:layout_height="86dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="43dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/img_swipe_hand" />
        </FrameLayout>

        <ImageView
            android:layout_width="22dp"
            android:layout_height="11dp"
            android:layout_marginTop="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_tip_pointer_up" />

        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tutorial_card"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/swipe_pages_tip"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSwipeTipOk"
                android:layout_width="116dp"
                android:layout_height="40dp"
                android:layout_gravity="end"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_outline_pill_large"
                android:gravity="center"
                android:text="@string/ok"
                android:textColor="@color/primary"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
