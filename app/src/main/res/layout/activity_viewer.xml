<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp">

        <LinearLayout
            android:id="@+id/normalBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnConvert"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/convert"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_convert_pdf"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/btnPages"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/pages"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pages"
                android:visibility="gone"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/btnMore"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnCloseSearch"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cancel"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                app:tint="@color/text_primary" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_field"
                android:hint="@string/search_in_document"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvSearchCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="40dp"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_up"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_down"
                app:tint="@color/text_primary" />
        </LinearLayout>
    </FrameLayout>

    <!-- Converting… / Saved successfully [Open] -->
    <LinearLayout
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/bannerProgress"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminateTint="@color/primary" />

        <ImageView
            android:id="@+id/bannerDone"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_check_circle"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvBanner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnBannerOpen"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_outline_pill"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/open"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnBannerClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface_variant">

        <com.theoccess.alldocreader.ui.viewer.ZoomLayout
            android:id="@+id/zoom"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                app:fastScrollEnabled="true"
                app:fastScrollHorizontalThumbDrawable="@drawable/fast_scroll_thumb"
                app:fastScrollHorizontalTrackDrawable="@drawable/fast_scroll_track"
                app:fastScrollVerticalThumbDrawable="@drawable/fast_scroll_thumb"
                app:fastScrollVerticalTrackDrawable="@drawable/fast_scroll_track" />
        </com.theoccess.alldocreader.ui.viewer.ZoomLayout>

        <TextView
            android:id="@+id/tvPageChip"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="12dp"
            android:background="@drawable/bg_page_chip"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- "Tap here to jump to the page directly" -->
        <LinearLayout
            android:id="@+id/jumpTip"
            android:layout_width="170dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="48dp"
            android:background="@drawable/bg_tip_bubble"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/jump_tip"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnTipOk"
                android:layout_width="64dp"
                android:layout_height="26dp"
                android:layout_gravity="end"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_outline_pill"
                android:gravity="center"
                android:text="@string/ok"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- "Continuous pages" / "Page by page" / "Color inversion: On" -->
        <TextView
            android:id="@+id/tvTopPill"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_top_pill"
            android:drawablePadding="6dp"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/fabEdit"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="@drawable/bg_fab_red"
            android:contentDescription="@string/edit"
            android:elevation="6dp"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pen"
            android:visibility="gone"
            app:tint="@color/white" />

        <LinearLayout
            android:id="@+id/loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:indeterminateTint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/loading"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Vertical / Rotate / Search / Invert / Share -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/surface"
        android:orientation="horizontal">

        <include android:id="@+id/tabMode" layout="@layout/item_bottom_tool" />
        <include android:id="@+id/tabRotate" layout="@layout/item_bottom_tool" />
        <include android:id="@+id/tabSearch" layout="@layout/item_bottom_tool" />
        <include android:id="@+id/tabInvert" layout="@layout/item_bottom_tool" />
        <include android:id="@+id/tabShare" layout="@layout/item_bottom_tool" />
    </LinearLayout>
</LinearLayout>
