<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvSuccess"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_success_pill"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:text="@string/converted_successfully_excl"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_check_circle_outline"
            app:drawableTint="@color/white" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- notebook-style preview of the first page -->
            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="178dp"
                android:layout_marginTop="16dp">

                <ImageView
                    android:id="@+id/spark1"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="18dp"
                    android:layout_marginBottom="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sparkle" />

                <ImageView
                    android:id="@+id/spark2"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="start|top"
                    android:layout_marginStart="30dp"
                    android:layout_marginTop="36dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sparkle" />

                <ImageView
                    android:id="@+id/spark3"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="end|bottom"
                    android:layout_marginEnd="34dp"
                    android:layout_marginBottom="30dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sparkle" />

                <FrameLayout
                    android:id="@+id/notebook"
                    android:layout_width="120dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_notebook"
                    android:elevation="6dp">

                    <ImageView
                        android:id="@+id/ivPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="6dp"
                        android:layout_marginBottom="6dp"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="2dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_spiral" />
                </FrameLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnRename"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/rename"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_rename"
                    app:tint="@color/text_hint" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnViewLocally"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_view_locally"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="10dp"
                android:text="@string/view_locally"
                android:textColor="@color/primary"
                android:textSize="14sp"
                app:drawableStartCompat="@drawable/ic_folder_outline"
                app:drawableTint="@color/primary" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnOpen"
                    android:layout_width="140dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_outline_btn"
                    android:gravity="center"
                    android:text="@string/open"
                    android:textColor="@color/primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnShare"
                    android:layout_width="140dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_apply_btn"
                    android:gravity="center"
                    android:text="@string/share"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/toolsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="36dp"
                android:layout_marginEnd="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tools_line_left" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:text="@string/tools"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tools_line_right" />
            </LinearLayout>

            <GridLayout
                android:id="@+id/toolsGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="8dp"
                android:columnCount="4" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
